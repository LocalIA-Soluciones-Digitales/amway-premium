# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Technical reference only (reverse-engineering CiaoEnergy's UX) — never part
# of the app, never imported, never committed.
/CiaoEnergy/

# Raw source marketing material (official Amway product photography, launch
# video, PDF/PPTX dossier) — the web-ready derivatives it was processed into
# live in public/images/xs-energy and public/videos, which ARE committed.
/XS Energy/

# typescript
*.tsbuildinfo
next-env.d.ts
